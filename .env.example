# Set this to the address where your local API is listening.
RECIPES_API_BASE_URL=http://127.0.0.1:8787
# Server-side authentication token. Keep this value private.
RECIPE_API_BEARER_TOKEN=replace-with-generated-token
# Client-side copy of the same token when a client loads this file.
RECIPES_API_BEARER_TOKEN=replace-with-generated-token
# Legacy client/server compatibility variable.
RECIPES_API_KEY=
RECIPE_CUSTOM_INSTRUCTIONS_PATH=structured/recipe_custom_instructions.md
RECIPE_DATABASE_PATH=structured/recipes.db
RECIPE_DATA_SOURCE=ndjson
